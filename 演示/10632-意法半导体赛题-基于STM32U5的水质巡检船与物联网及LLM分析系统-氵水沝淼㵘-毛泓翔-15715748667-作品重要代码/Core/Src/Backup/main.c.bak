static uint32_t Telemetry_AdcRawToMv(uint32_t raw);
static int32_t Telemetry_ScaleFloat(float value, float scale);
static int32_t Telemetry_CalcPhX100(uint32_t sensor_mv);
static uint32_t Telemetry_CalcTurbidityNtu(uint32_t sensor_mv);
static void Telemetry_SendData(void);
/* USER CODE END PFP */

/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */
static uint32_t Telemetry_ReadAdcRaw(uint32_t channel)
{
  ADC_ChannelConfTypeDef sConfig = {0};
  uint32_t value = 0;

  HAL_ADC_Stop(&hadc1);

  sConfig.Channel = channel;
  sConfig.Rank = ADC_REGULAR_RANK_1;
  sConfig.SamplingTime = ADC_SAMPLETIME_391CYCLES_5;
  sConfig.SingleDiff = ADC_SINGLE_ENDED;
  sConfig.OffsetNumber = ADC_OFFSET_NONE;
  sConfig.Offset = 0;

  if (HAL_ADC_ConfigChannel(&hadc1, &sConfig) != HAL_OK)
  {
    return 0xFFFFFFFFU;
  }

  if (HAL_ADC_Start(&hadc1) != HAL_OK)
  {
    return 0xFFFFFFFFU;
  }

  if (HAL_ADC_PollForConversion(&hadc1, 20) == HAL_OK)
  {
    value = HAL_ADC_GetValue(&hadc1);
  }
  else
  {
    value = 0xFFFFFFFFU;
  }

  HAL_ADC_Stop(&hadc1);
  return value;
}

static uint32_t Telemetry_AdcRawToMv(uint32_t raw)
{
  return raw * TELEMETRY_ADC_VREF_MV / TELEMETRY_ADC_FULL_SCALE;
}

static int32_t Telemetry_ScaleFloat(float value, float scale)
{
  if (value >= 0.0f)
  {
    return (int32_t)(value * scale + 0.5f);
  }
  return (int32_t)(value * scale - 0.5f);
}

static int32_t Telemetry_CalcPhX100(uint32_t sensor_mv)
{
  float voltage = (float)sensor_mv / 1000.0f;
  float ph = -5.6342f * voltage + 16.413f;

  if (ph < 0.0f) ph = 0.0f;
  if (ph > 14.0f) ph = 14.0f;

  return Telemetry_ScaleFloat(ph, 100.0f);
}

static uint32_t Telemetry_CalcTurbidityNtu(uint32_t sensor_mv)
{
  float voltage = (float)sensor_mv / 1000.0f;
  float ntu = -1120.4f * voltage * voltage + 5742.3f * voltage - 4352.9f;

  if (ntu < 0.0f) ntu = 0.0f;
  if (ntu > 3000.0f) ntu = 3000.0f;

  return (uint32_t)(ntu + 0.5f);
}

static void Telemetry_SendData(void)
{
  static uint32_t seq = 0;
  uint32_t ph_raw = Telemetry_ReadAdcRaw(PH_ADC_CHANNEL);
  uint32_t turb_raw = Telemetry_ReadAdcRaw(TURBIDITY_ADC_CHANNEL);
  uint32_t ph_adc_mv = (ph_raw == 0xFFFFFFFFU) ? 0U : Telemetry_AdcRawToMv(ph_raw);
  uint32_t turb_adc_mv = (turb_raw == 0xFFFFFFFFU) ? 0U : Telemetry_AdcRawToMv(turb_raw);
  uint32_t ph_sensor_mv = ph_adc_mv * TELEMETRY_DIVIDER_SCALE;
  uint32_t turb_sensor_mv = turb_adc_mv * TELEMETRY_DIVIDER_SCALE;
  int32_t ph_x100 = (ph_raw == 0xFFFFFFFFU) ? 0 : Telemetry_CalcPhX100(ph_sensor_mv);
  uint32_t turb_ntu = (turb_raw == 0xFFFFFFFFU) ? 0U : Telemetry_CalcTurbidityNtu(turb_sensor_mv);
  uint8_t turb_dout = (HAL_GPIO_ReadPin(TURBIDITY_DIGITAL_PORT, TURBIDITY_DIGITAL_PIN) == GPIO_PIN_SET) ? 1U : 0U;
  float temp = DS18B20_GetTemp();
  uint8_t temp_valid = (temp > -100.0f) ? 1U : 0U;
  int32_t temp_x100 = temp_valid ? Telemetry_ScaleFloat(temp, 100.0f) : 0;
  uint8_t gps_valid = GPS_IsFixed() ? 1U : 0U;
  int32_t lat_x1e7 = gps_valid ? Telemetry_ScaleFloat(gps_data.latitude, 10000000.0f) : 0;
  int32_t lon_x1e7 = gps_valid ? Telemetry_ScaleFloat(gps_data.longitude, 10000000.0f) : 0;

  Lora_Printf("{\"t\":\"data\",\"v\":1,\"seq\":%lu,\"ms\":%lu,"
              "\"ph\":%ld,\"phr\":%lu,\"phmv\":%lu,"
              "\"tb\":%lu,\"tbr\":%lu,\"tbmv\":%lu,\"td\":%u,"
              "\"tc\":%ld,\"tv\":%u,"
              "\"fix\":%u,\"sat\":%u,\"lat\":%ld,\"lon\":%ld,"
              "\"gb\":%lu,\"gl\":%lu}\r\n",
              (unsigned long)seq++,
              (unsigned long)HAL_GetTick(),
              (long)ph_x100,
              (unsigned long)((ph_raw == 0xFFFFFFFFU) ? 0U : ph_raw),
              (unsigned long)ph_sensor_mv,
              (unsigned long)turb_ntu,
              (unsigned long)((turb_raw == 0xFFFFFFFFU) ? 0U : turb_raw),
              (unsigned long)turb_sensor_mv,
              turb_dout,
              (long)temp_x100,
              temp_valid,
              gps_data.fix,
              gps_data.satellite_num,
              (long)lat_x1e7,
              (long)lon_x1e7,
              (unsigned long)gps_rx_count,
              (unsigned long)gps_sentence_count);
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_ICACHE_Init();
  MX_TIM1_Init();
  MX_ADC1_Init();
  MX_USART2_UART_Init();
  MX_USART3_UART_Init();
  MX_UART4_Init();
  /* USER CODE BEGIN 2 */
  Motor_Init();
  Motor_Stop_All();
  Lora_Init();
  DS18B20_Init();
  PH_Init();
  GPS_Init();

  Lora_Printf("{\"t\":\"boot\",\"v\":1,\"ms\":%lu,\"msg\":\"boat telemetry start\",\"div\":%u}\r\n",
              (unsigned long)HAL_GetTick(),
              TELEMETRY_DIVIDER_SCALE);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    Telemetry_SendData();

    HAL_Delay(250);
  }
  /* USER CODE END 3 */
}

