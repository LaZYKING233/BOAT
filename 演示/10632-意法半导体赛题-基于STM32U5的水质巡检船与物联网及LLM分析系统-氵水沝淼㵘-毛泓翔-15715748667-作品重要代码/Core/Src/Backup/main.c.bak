/* USER CODE BEGIN PD */
#define TELEMETRY_ADC_FULL_SCALE   16383U
#define TELEMETRY_ADC_VREF_MV      3300U
#define TELEMETRY_DIVIDER_SCALE    20U
/* USER CODE END PD */

