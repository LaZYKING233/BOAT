/* USER CODE BEGIN 1 */
static uint8_t imu901_rx_byte = 0;
uint8_t gps_rx_byte = 0;

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if(huart->Instance == USART2)
    {
        if(imu901_unpack(imu901_rx_byte))
        {
            if(rxPacket.startByte2 == UP_BYTE2)
            {
                atkpParsing(&rxPacket);
            }
        }
        HAL_UART_Receive_IT(&huart2, &imu901_rx_byte, 1);
    }
    else if(huart->Instance == UART4)
    {
        GPS_ProcessByte(gps_rx_byte);
        HAL_UART_Receive_IT(&huart4, &gps_rx_byte, 1);
    }
}
/* USER CODE END 1 */
