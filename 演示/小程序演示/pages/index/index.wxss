/* ==================== 1. Raymarine 航用级色标系统 ==================== */
page {
  /* 航仪钢材灰黑与高对比度海洋探索绿 */
  --steel-navy: #0f172a;          /* 军工仪表深灰色（主要文字） */
  --marine-teal: #0d9488;         /* 航仪主色：高饱和松石绿 */
  --marine-teal-hover: #115e59;   /* 松石绿激活态 */
  --marine-teal-tint: #f0fdfa;    /* 极浅松石绿（选中卡片背景） */
  
  --bg-glacier: #f8fafc;          /* 纯净冰川冷灰底色 */
  --card-solid: #ffffff;          /* 纯白卡片 */
  --panel-gray: #f1f5f9;          /* 冷灰输入框底面板 */
  
  /* 工业分割线 */
  --border-steel: #cbd5e1;        /* 标称仪表分割线 */
  --border-steel-light: #e2e8f0;  /* 极淡辅助线 */
  
  /* 严格的物理数值警示色 (国际航用标准) */
  --state-success: #10b981;       /* 正常/标称绿色 */
  --state-warning: #f59e0b;       /* 警告明黄 */
  --state-danger: #ef4444;        /* 危急红色 */

  min-height: 100%;
  background-color: var(--bg-glacier);
  color: var(--steel-navy);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page-scroll {
  height: 100vh;
}

.page-shell {
  box-sizing: border-box;
  padding: 28rpx; /* 增加页面边缘间距 */
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 28rpx; /* 增大卡片之间的上下呼吸感 */
}

/* ==================== 2. 专业控制台卡片 & 顶部面板 ==================== */

/* 物理扁平卡片：去重阴影，改用 1rpx 微距工业钢材边框 */
.card {
  background: var(--card-solid);
  border: 1rpx solid var(--border-steel);
  border-radius: 8rpx; /* 规整的工业级小圆角 */
  padding: 32rpx; /* 增大卡片内部留白，防止内容顶边 */
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.02);
  box-sizing: border-box;
}

/* 顶部持久主运行面板（稳重深邃钢灰色） */
.hero-card {
  background: #1e293b; 
  border: 1rpx solid var(--steel-navy);
  border-radius: 8rpx;
  color: #ffffff;
  padding: 36rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.08);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  padding-bottom: 24rpx;
  margin-bottom: 24rpx; /* 确保标题与下方连接表单不粘连 */
}

.hero-title {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.hero-subtitle {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

/* ==================== 3. 导航：高灵敏物理选项卡段 ==================== */
.tab-segment {
  display: flex;
  background: #e2e8f0;
  padding: 8rpx;
  border-radius: 6rpx;
  border: 1rpx solid var(--border-steel);
  margin: 8rpx 0 16rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0; /* 增大点击触控区域，更跟手 */
  transition: all 0.15s ease-in-out;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-active {
  background: var(--card-solid);
  box-shadow: 0 4rpx 10rpx rgba(15, 23, 42, 0.06);
}

.tab-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #475569;
}

.tab-active .tab-text {
  color: var(--marine-teal);
}

/* ==================== 4. 物理表单与元素对齐 (解决对齐和粘连的核心) ==================== */
.server-form {
  margin-top: 24rpx;
  display: flex;
  gap: 20rpx; /* 拓宽输入框与连接按钮的间距 */
  align-items: flex-end; /* 强行底部对齐 */
  width: 100%;
  box-sizing: border-box;
}

.input-group {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.port-group {
  max-width: 160rpx; /* 端口稍微放宽，防止部分机型挤压 */
}

.input-label,
.form-label,
.switch-label-field {
  display: block;
  font-size: 21rpx;
  font-weight: 700;
  color: #64748b;
  margin-bottom: 12rpx; /* 增大标签与输入框的空隙 */
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.switch-label-field {
  color: var(--steel-navy);
  font-size: 24rpx;
  margin-bottom: 0; /* 开关行的标签不需要底边距 */
}

/* 
  所有输入控件的高高度统一对齐规范 
  强制设定 84rpx 物理高度，确保与 Buttons 的高度完全吻合
*/
.field-input,
.chat-input,
.picker-field,
.field-textarea {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx; /* 设定统一物理高度 */
  min-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 6rpx;
  background: #ffffff;
  color: var(--steel-navy);
  border: 1rpx solid var(--border-steel);
  font-size: 26rpx;
  transition: all 0.15s ease-in-out;
}

.field-input:focus,
.field-textarea:focus {
  border-color: var(--marine-teal);
  background: #ffffff;
  box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.1); /* 精致的淡色外发光 */
}

.field-textarea {
  height: auto !important;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
  font-family: monospace;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--panel-gray);
  font-weight: 600;
}

.chat-input {
  background: var(--panel-gray);
}

.compact-input {
  height: 76rpx;
  min-height: 76rpx;
}

.form-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  margin-bottom: 24rpx; /* 纵向表单元素之间，增加 24rpx 物理间距，防止粘连 */
}

.form-row:last-child {
  margin-bottom: 0;
}

/* ==================== 5. 指示芯片与度量卡 ==================== */
.status-grid {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.status-chip {
  padding: 18rpx 20rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  gap: 6rpx; /* 指示名称与状态词微距空隙 */
}

.status-label {
  font-size: 18rpx;
  color: #94a3b8;
  font-weight: 600;
}

.status-value {
  font-size: 24rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/* 状态对应色 */
.state-ok { color: var(--state-success); }
.state-err { color: var(--state-warning); }

/* 数据度量卡片 (pH, 水温等) */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx; /* 增大度量卡之间的间隙 */
}

.metric-card {
  display: flex;
  flex-direction: column;
  padding: 28rpx;
  background: var(--card-solid);
  border: 1rpx solid var(--border-steel);
}

.metric-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #64748b;
}

.metric-value {
  font-size: 44rpx;
  color: var(--marine-teal);
  font-weight: 800;
  margin: 12rpx 0 4rpx; /* 增加大数字上下的间距 */
  font-variant-numeric: tabular-nums;
}

.metric-subtext {
  font-size: 18rpx;
  color: #94a3b8;
}

/* ==================== 6. 工业标准物理按键 (对齐输入框高度) ==================== */
.primary-btn,
.outline-btn,
.ghost-btn,
.danger-btn {
  border-radius: 6rpx !important; 
  font-size: 24rpx !important;
  font-weight: 700 !important;
  height: 84rpx !important; /* 强制设定 84rpx，完美对齐 Inputs */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-sizing: border-box;
  padding: 0 32rpx !important;
}

/* 控制台顶部网络测试动作键（小型） */
.header-action-btn {
  border-radius: 4rpx !important;
  font-size: 20rpx !important;
  font-weight: 700 !important;
  height: 56rpx !important;
  padding: 0 20rpx !important;
  background: rgba(255, 255, 255, 0.1) !important;
  color: #ffffff !important;
  border: 1rpx solid rgba(255, 255, 255, 0.15) !important;
  display: inline-flex;
  align-items: center;
}

/* 网格内动作按键高度微收缩，防止撑破 */
.action-grid button,
.triple-grid button,
.double-grid button {
  height: 76rpx !important;
  width: 100% !important;
  margin: 0 !important;
}

/* 按钮点击态反馈 */
.primary-btn:active, .outline-btn:active, .ghost-btn:active, .danger-btn:active, .header-action-btn:active {
  opacity: 0.85;
}

/* 松石绿强交互按键 */
.primary-btn {
  background: var(--marine-teal) !important;
  color: #ffffff !important;
}

/* 断开状态下的醒目警示红按钮 */
.primary-btn.btn-disconnect {
  background: var(--state-danger) !important;
}

.outline-btn {
  background: #ffffff !important;
  color: var(--marine-teal) !important;
  border: 1rpx solid rgba(13, 148, 136, 0.3) !important;
}

.ghost-btn {
  background: var(--panel-gray) !important;
  color: var(--steel-navy) !important;
  border: 1rpx solid var(--border-steel) !important;
}

.danger-btn {
  background: #fef2f2 !important;
  color: var(--state-danger) !important;
  border: 1rpx solid rgba(239, 68, 68, 0.2) !important;
}

.connect-btn {
  flex-shrink: 0;
  min-width: 140rpx;
  margin: 0 !important;
}

.full-btn {
  width: 100%;
}

/* ==================== 7. 网格化布局架构 (全面调宽 Gap 防止堆积) ==================== */
.action-grid,
.form-grid,
.double-grid,
.triple-grid,
.switch-grid,
.sample-grid,
.detail-grid,
.zone-stats {
  display: grid;
  gap: 20rpx; /* 间距从原本狭窄的 12rpx 扩展至宽敞的 20rpx */
}

.action-grid,
.form-grid,
.sample-grid,
.detail-grid,
.zone-stats {
  margin-top: 24rpx; /* 模块组件与上方标题增大留白 */
}

.action-grid { grid-template-columns: repeat(3, 1fr); }
.action-grid-wide { grid-template-columns: repeat(4, 1fr); }
.action-grid-two, .double-grid { grid-template-columns: repeat(2, 1fr); }
.action-grid-four, .triple-grid { grid-template-columns: repeat(3, 1fr); }
.form-grid { grid-template-columns: 1fr; }
.switch-grid { margin-top: 18rpx; grid-template-columns: repeat(2, 1fr); }
.detail-grid, .sample-grid { grid-template-columns: repeat(2, 1fr); }
.sample-grid { grid-template-columns: repeat(3, 1fr); }

/* --- 7a. 养殖区卡片列表 --- */
.zone-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.zone-card {
  padding: 28rpx;
  border-radius: 6rpx;
  background: var(--panel-gray);
  border: 1rpx solid var(--border-steel-light);
  transition: all 0.15s ease-in-out;
}

/* 选中高亮态：松石绿描边 */
.zone-card-selected {
  border-color: var(--marine-teal);
  border-left: 8rpx solid var(--marine-teal);
  background: var(--marine-teal-tint);
}

.zone-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx; /* 拓宽上部名称与下方三柱 pH 值的距离 */
}

.zone-name {
  font-size: 28rpx;
  font-weight: 700;
}

.zone-species {
  font-size: 21rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.zone-badges {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

/* 状态标签 */
.risk-badge,
.task-badge {
  padding: 6rpx 14rpx;
  border-radius: 4rpx;
  font-size: 18rpx;
  font-weight: 700;
  text-transform: uppercase;
}

/* 状态警示 */
.risk-normal { background: #dcfce7; color: #15803d; }
.risk-warning { background: #fef3c7; color: #b45309; }
.risk-danger { background: #fee2e2; color: #b91c1c; }
.risk-unknown { background: #e2e8f0; color: #475569; }
.task-badge { background: #eff6ff; color: #1e40af; border: 1rpx solid rgba(30, 64, 175, 0.15); }

.zone-stat {
  background: #ffffff;
  border: 1rpx solid var(--border-steel-light);
  padding: 18rpx 12rpx;
  text-align: center;
  border-radius: 4rpx;
}

.zone-stat-label, .detail-label {
  font-size: 18rpx;
  color: #64748b;
  font-weight: 700;
  display: block;
  margin-bottom: 6rpx;
}

.zone-stat-value, .sample-value, .detail-value {
  font-size: 26rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.zone-footer {
  margin-top: 20rpx;
  border-top: 1rpx dashed var(--border-steel-light);
  padding-top: 16rpx;
  font-size: 18rpx;
  color: #94a3b8;
}

/* ==================== 8. 水质分析、AI 气泡、高精地图 ==================== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid var(--border-steel-light);
  padding-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
}

.section-subtitle {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.map-panel {
  width: 100%;
  height: 440rpx;
  margin-top: 24rpx;
  border: 1rpx solid var(--border-steel);
  border-radius: 6rpx;
}

.map-placeholder {
  width: 100%;
  height: 440rpx;
  margin-top: 24rpx;
  border: 1rpx dashed var(--border-steel);
  border-radius: 6rpx;
  background: var(--panel-gray);
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-placeholder-text {
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
  padding: 0 40rpx;
}

.map-hint {
  font-size: 18rpx;
  color: #64748b;
  margin-top: 14rpx;
  line-height: 1.5;
}

.form-value-hidden {
  font-size: 24rpx;
  color: #94a3b8;
  padding: 16rpx 0;
}

.detail-panel {
  background: var(--panel-gray);
  border: 1rpx solid var(--border-steel-light);
  padding: 24rpx;
  margin-top: 24rpx;
  border-radius: 4rpx;
}

.detail-line {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  margin-bottom: 14rpx;
}

.detail-line:last-child {
  margin-bottom: 0;
}

.detail-line-label {
  font-weight: 700;
  color: #64748b;
}

.detail-line-value {
  font-weight: 600;
}

/* 结构化诊断箱 */
.analysis-box {
  background: #f8fafc;
  border-left: 6rpx solid var(--marine-teal);
  padding: 24rpx;
  margin-top: 24rpx;
}

.analysis-title {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--marine-teal);
}

.analysis-text {
  font-size: 22rpx;
  line-height: 1.6;
  margin-top: 10rpx;
}

/* AI 决策建议聊天栏 */
.chat-scroll {
  max-height: 380rpx;
  min-height: 180rpx;
  border: 1rpx solid var(--border-steel);
  background: var(--panel-gray);
  padding: 20rpx;
  margin-top: 20rpx;
}

.chat-item {
  padding: 18rpx 20rpx;
  border-radius: 4rpx;
  margin-bottom: 16rpx;
  font-size: 22rpx;
}

.chat-user {
  background: #ffffff;
  border-left: 4rpx solid var(--marine-teal);
}

.chat-assistant {
  background: #eff6ff;
  border-left: 4rpx solid var(--state-success);
}

.chat-role {
  font-weight: 700;
  margin-bottom: 6rpx;
}

.chat-text {
  line-height: 1.6;
}

.chat-input-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.chat-send {
  min-width: 120rpx;
}

/* ==================== 9. 原生控制台与串口日志 (高阶调试黑面板) ==================== */
.code-scroll {
  background: #090d16; /* 终端黑 */
  padding: 20rpx;
  border: 1rpx solid #1e293b;
  border-radius: 4rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.log-scroll {
  max-height: 240rpx;
}

.code-title {
  font-size: 18rpx;
  font-weight: 700;
  color: #64748b;
  text-transform: uppercase;
  margin-top: 24rpx;
}

.code-block {
  font-family: monospace;
  font-size: 18rpx;
  color: #38bdf8; /* 青蓝色报文 */
  line-height: 1.6;
  white-space: pre;
}

.code-hidden {
  color: #64748b;
  font-style: italic;
}

.log-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 20rpx;
  max-height: 260rpx;
  overflow-y: scroll;
}

.log-item {
  font-family: monospace;
  font-size: 20rpx;
  color: #475569;
  line-height: 1.5;
  border-bottom: 1rpx solid var(--border-steel-light);
  padding-bottom: 8rpx;
}

/* ==================== 10. 高阶编辑器与空状态 ==================== */
.editor-panel {
  background: #ffffff;
  border: 1px solid var(--border-steel);
  padding: 28rpx;
  margin-top: 24rpx;
}

.editor-title {
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.empty-block {
  padding: 56rpx 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
}

/* 纵向间隙修饰 */
.compact-top {
  margin-top: 24rpx; /* 所有紧贴元素的强制拓宽间隙 */
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0; /* 增加行内填充防止紧贴 */
  width: 100%;
  box-sizing: border-box;
}

.switch-row-hero {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  padding-bottom: 16rpx;
  margin-bottom: 12rpx;
}

.hero-toolbar {
  margin-top: 24rpx;
}

.tips-row {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 12rpx;
}
