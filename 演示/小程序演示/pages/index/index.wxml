<scroll-view class="page-scroll" scroll-y="true" enable-flex="true">
  <view class="page-shell">
    
    <!-- 1. 顶部持久运行状态栏 (精简版) -->
    <view class="hero-card">
      <view class="hero-top">
        <view>
          <view class="hero-title">智航清泓</view>
          <view class="hero-subtitle">无人巡检船控制系统</view>
        </view>
        <button class="header-action-btn" size="mini" bindtap="goNetworkTest">网络测试</button>
      </view>

      <!-- 核心连接表单 (更紧凑，突出状态) -->
      <view class="server-form">
        <view class="input-group">
          <text class="input-label">HOST IP</text>
          <input class="field-input" value="{{ip}}" bindinput="onIpInput" placeholder="192.168.x.x" />
        </view>
        <view class="input-group port-group">
          <text class="input-label">PORT</text>
          <input class="field-input" value="{{port}}" bindinput="onPortInput" type="number" placeholder="8765" />
        </view>
        <button class="primary-btn connect-btn {{connected ? 'btn-disconnect' : ''}}" size="mini" bindtap="toggleConnection">
          {{connected ? '断开' : '连接'}}
        </button>
      </view>

      <!-- 连接状态指示芯片 -->
      <view class="status-grid">
        <view class="status-chip">
          <text class="status-label">SOCKET 连接</text>
          <text class="status-value {{connected ? 'state-ok' : 'state-err'}}">{{connectionText}}</text>
        </view>
        <view class="status-chip">
          <text class="status-label">船舶硬件</text>
          <text class="status-value {{status.connected ? 'state-ok' : 'state-err'}}">{{boatText}}</text>
        </view>
        <view class="status-chip">
          <text class="status-label">最新遥测时间</text>
          <text class="status-value">{{lastDataText}}</text>
        </view>
      </view>
    </view>

    <!-- 2. 工业级导航 Segment Control (切换选项卡) -->
    <!-- 
      说明：currentTab 可取值：'monitor' (默认) / 'control' / 'config' 
      JS 中添加：switchTab(e) { this.setData({ currentTab: e.currentTarget.dataset.tab }) }
    -->
    <view class="tab-segment">
      <view class="tab-item {{currentTab === 'monitor' || !currentTab ? 'tab-active' : ''}}" data-tab="monitor" bindtap="switchTab">
        <text class="tab-text">数据监视</text>
      </view>
      <view class="tab-item {{currentTab === 'control' ? 'tab-active' : ''}}" data-tab="control" bindtap="switchTab">
        <text class="tab-text">设备控制</text>
      </view>
      <view class="tab-item {{currentTab === 'config' ? 'tab-active' : ''}}" data-tab="config" bindtap="switchTab">
        <text class="tab-text">高级配置</text>
      </view>
    </view>


    <!-- ==================== TAB 1: 数据监视 ==================== -->
    <block wx:if="{{currentTab === 'monitor' || !currentTab}}">
      
      <!-- 遥测度量网络 -->
      <view class="metrics-grid">
        <block wx:for="{{metricCards}}" wx:key="key">
          <view class="metric-card card">
            <text class="metric-label">{{item.label}}</text>
            <text class="metric-value">{{item.value}}</text>
            <text class="metric-subtext">{{item.subtext}}</text>
          </view>
        </block>
      </view>

      <!-- 养殖水域高精度地图 -->
      <view class="card">
        <view class="section-header">
          <view>
            <view class="section-title">高精航行图</view>
            <view class="section-subtitle" wx:if="{{!hideLocation}}">点击地图选定采样目标航点</view>
            <view class="section-subtitle" wx:if="{{hideLocation}}">地图及位置信息已隐藏</view>
          </view>
          <view class="map-actions" wx:if="{{!hideLocation}}">
            <button class="ghost-btn" size="mini" bindtap="recenterBoat">定位船</button>
            <button class="ghost-btn" size="mini" bindtap="clearTarget">清除</button>
          </view>
        </view>
        <view wx:if="{{hideLocation}}" class="map-placeholder">
          <text class="map-placeholder-text">地图及位置信息已隐藏（比赛要求）</text>
        </view>
        <map
          wx:else
          class="map-panel"
          longitude="{{mapLongitude}}"
          latitude="{{mapLatitude}}"
          scale="{{mapScale}}"
          polygons="{{polygons}}"
          circles="{{circles}}"
          show-location="true"
          bindtap="onMapTap"
        ></map>
        <view wx:if="{{!hideLocation}}" class="map-hint">■ 矩形表示养殖区域 ｜ ● 目标锚点 ｜ ● 船舶位置</view>
      </view>

      <!-- 养殖区域列表 -->
      <view class="card">
        <view class="section-header">
          <view>
            <view class="section-title">养殖区列表</view>
            <view class="section-subtitle">点击切换当前执行作业水域</view>
          </view>
        </view>
        
        <view wx:if="{{zoneCards.length}}" class="zone-list">
          <block wx:for="{{zoneCards}}" wx:key="id">
            <view class="zone-card {{item.selected ? 'zone-card-selected' : ''}}" data-id="{{item.id}}" bindtap="selectZone">
              <view class="zone-top">
                <view>
                  <view class="zone-name">{{item.name}}</view>
                  <view class="zone-species">物种: {{item.speciesLabel}}</view>
                </view>
                <view class="zone-badges">
                  <text class="risk-badge {{item.riskClass}}">{{item.riskLabel}}</text>
                  <text wx:if="{{item.samplingText}}" class="task-badge">{{item.samplingText}}</text>
                </view>
              </view>
              <view class="zone-stats">
                <view class="zone-stat">
                  <text class="zone-stat-label">pH 值</text>
                  <text class="zone-stat-value">{{item.phText}}</text>
                </view>
                <view class="zone-stat">
                  <text class="zone-stat-label">水温 ℃</text>
                  <text class="zone-stat-value">{{item.tempText}}</text>
                </view>
                <view class="zone-stat">
                  <text class="zone-stat-label">浊度 NTU</text>
                  <text class="zone-stat-value">{{item.turbidityText}}</text>
                </view>
              </view>
              <view class="zone-footer">更新时间: {{item.updatedText}}</view>
            </view>
          </block>
        </view>
        <view wx:else class="empty-block">暂无水域数据，请连接服务端获取</view>
      </view>

      <!-- 选定水域详情与水质分析 -->
      <view class="card" wx:if="{{selectedZoneView}}">
        <view class="section-header">
          <view>
            <view class="section-title">{{selectedZoneView.name}}</view>
            <view class="section-subtitle">当前监测点详情与水质历史</view>
          </view>
          <button class="primary-btn" size="mini" bindtap="analyzeZone">分析水质</button>
        </view>

        <view class="detail-grid">
          <view class="detail-item">
            <text class="detail-label">风险状态</text>
            <text class="risk-badge {{selectedZoneView.riskClass}}">{{selectedZoneView.riskLabel}}</text>
            <text class="detail-desc">{{selectedZoneView.riskHint}}</text>
          </view>
          <view class="detail-item">
            <text class="detail-label">采样任务状态</text>
            <text class="detail-value">{{selectedZoneView.samplingText}}</text>
            <text wx:if="{{selectedZoneView.warningText}}" class="detail-desc warn-text">{{selectedZoneView.warningText}}</text>
          </view>
        </view>

        <view class="detail-panel">
          <view class="detail-line"><text class="detail-line-label">物理阈值</text><text class="detail-line-value">{{selectedZoneView.thresholdsText}}</text></view>
          <view class="detail-line"><text class="detail-line-label">区域中心</text><text class="detail-line-value">{{selectedZoneView.centerText}}</text></view>
          <view class="detail-line"><text class="detail-line-label">最后采样</text><text class="detail-line-value">{{selectedZoneView.sampleTimeText}}</text></view>
        </view>

        <!-- 历史水质卡片 -->
        <view class="analysis-box">
          <view class="analysis-title">水质诊断分析</view>
          <view class="analysis-text">{{selectedZoneView.analysisSummary}}</view>
          <view class="analysis-meta">{{selectedZoneView.analysisMeta}}</view>
          <view class="analysis-reasons">{{selectedZoneView.analysisReasons}}</view>
        </view>

        <!-- 样本记录 -->
        <view class="history-title">历史采样样本</view>
        <view wx:if="{{selectedZoneView.sampleItems.length}}" class="history-list">
          <block wx:for="{{selectedZoneView.sampleItems}}" wx:key="id">
            <view class="history-item column-item">
              <view class="history-item-title">{{item.title}}</view>
              <view class="history-item-value">{{item.value}}</view>
            </view>
          </block>
        </view>
        <view wx:else class="empty-block">该区域暂无样本数据，可下发巡检指令。</view>
      </view>

      <!-- AI 决策顾问 -->
      <view class="card">
        <view class="section-header">
          <view>
            <view class="section-title">AI 水质决策顾问</view>
            <view class="section-subtitle">结合国标数据与 LLM 给出的投喂及治理建议</view>
          </view>
        </view>

        <view wx:if="{{selectedZoneView}}" class="chat-box">
          <scroll-view class="chat-scroll" scroll-y="true" enable-flex="true">
            <view wx:if="{{!chatMessages.length}}" class="empty-block compact-empty">暂无对话记录。选择区域并发送提问，AI 助手将获取传感器阈值综合解答。</view>
            <block wx:for="{{chatMessages}}" wx:key="id">
              <view class="chat-item {{item.role === 'user' ? 'chat-user' : 'chat-assistant'}}">
                <view class="chat-role">{{item.role === 'user' ? '操作员' : '水质 AI 专家'}}</view>
                <view class="chat-text">{{item.text}}</view>
                <view class="chat-meta">{{item.meta}}</view>
              </view>
            </block>
          </scroll-view>
          <view class="chat-input-row">
            <input class="chat-input" value="{{chatInput}}" bindinput="onChatInput" placeholder="请输入：当前水温是否适合投喂草鱼？" />
            <button class="primary-btn chat-send" size="mini" bindtap="sendAiSuggestion">发送</button>
          </view>
        </view>
        <view wx:else class="empty-block">请先在上方列表选择一个养殖区域。</view>
      </view>

    </block>


    <!-- ==================== TAB 2: 设备控制 ==================== -->
    <block wx:if="{{currentTab === 'control'}}">
      
      <!-- 快捷巡航动作指令 -->
      <view class="card">
        <view class="section-header">
          <view>
            <view class="section-title">船舶自动导航控制</view>
            <view class="section-subtitle">执行巡航、指令下发与采样动作</view>
          </view>
        </view>
        <view class="action-grid action-grid-wide">
          <button class="outline-btn" size="mini" data-cmd="start" bindtap="sendQuickCommand">自动巡航</button>
          <button class="danger-btn" size="mini" data-cmd="stop" bindtap="sendQuickCommand">紧急停船</button>
          <button class="outline-btn" size="mini" data-cmd="sensor" bindtap="sendQuickCommand">标定传感器</button>
          <button class="primary-btn" size="mini" bindtap="startZoneSampling">全区巡检</button>
          <button class="outline-btn" size="mini" bindtap="sendSelectedTarget">发航点</button>
          <button class="ghost-btn" size="mini" bindtap="manualSample">单点采样</button>
          <button class="ghost-btn" size="mini" bindtap="cancelSampling">中止采样</button>
          <button class="primary-btn" size="mini" bindtap="analyzeAll">一键诊断</button>
        </view>
      </view>

      <!-- 双电机动力与硬件校准 -->
      <view class="card" wx:if="{{advancedMode}}">
        <view class="section-header">
          <view>
            <view class="section-title">电机动力输出 & 舵向校准</view>
            <view class="section-subtitle">PWM 控制脉宽设定</view>
          </view>
        </view>
        <view class="double-grid">
          <input class="field-input compact-input" value="{{motorLeft}}" bindinput="setFormField" data-key="motorLeft" placeholder="左电机 PWM (-100 ~ 100)" />
          <input class="field-input compact-input" value="{{motorRight}}" bindinput="setFormField" data-key="motorRight" placeholder="右电机 PWM (-100 ~ 100)" />
        </view>
        <view class="action-grid action-grid-four compact-top">
          <button class="ghost-btn" size="mini" data-left="50" data-right="50" bindtap="setMotorPreset">前进</button>
          <button class="ghost-btn" size="mini" data-left="-50" data-right="-50" bindtap="setMotorPreset">后退</button>
          <button class="ghost-btn" size="mini" data-left="-30" data-right="30" bindtap="setMotorPreset">左旋</button>
          <button class="ghost-btn" size="mini" data-left="30" data-right="-30" bindtap="setMotorPreset">右旋</button>
        </view>
        <view class="action-grid action-grid-two compact-top">
          <button class="primary-btn" size="mini" bindtap="sendMotorCommand">写入指令</button>
          <button class="danger-btn" size="mini" bindtap="stopMotor">电机紧急归零</button>
        </view>
        <view class="double-grid compact-top">
          <input class="field-input compact-input" value="{{calLeftScale}}" bindinput="setFormField" data-key="calLeftScale" placeholder="左侧增益 Scale" />
          <input class="field-input compact-input" value="{{calRightScale}}" bindinput="setFormField" data-key="calRightScale" placeholder="右侧增益 Scale" />
        </view>
        <view class="double-grid compact-top">
          <input class="field-input compact-input" value="{{calLeftOffset}}" bindinput="setFormField" data-key="calLeftOffset" placeholder="左侧偏置 Offset" />
          <input class="field-input compact-input" value="{{calRightOffset}}" bindinput="setFormField" data-key="calRightOffset" placeholder="右侧偏置 Offset" />
        </view>
        <button class="primary-btn full-btn compact-top" size="mini" bindtap="sendCalibration">写入校准配置表</button>
      </view>

      <!-- 系统运行日志记录 -->
      <view class="card">
        <view class="section-header">
          <view>
            <view class="section-title">系统操作控制台日志</view>
            <view class="section-subtitle">最近记录的事件及通信日志</view>
          </view>
        </view>
        <view wx:if="{{eventLogs.length}}" class="log-list">
          <block wx:for="{{eventLogs}}" wx:key="*this">
            <view class="log-item">{{item}}</view>
          </block>
        </view>
        <view wx:else class="empty-block">暂无控制台操作日志</view>
      </view>

    </block>


    <!-- ==================== TAB 3: 参数配置 (高级模式) ==================== -->
    <block wx:if="{{currentTab === 'config'}}">
      
      <!-- 控制中心高级开关 -->
      <view class="card">
        <view class="section-header">
          <view>
            <view class="section-title">系统调试选项</view>
            <view class="section-subtitle">激活高级底盘控制、LLM接口与调试报文</view>
          </view>
        </view>
        <view class="hero-toolbar">
          <view class="switch-row switch-row-hero">
            <text class="switch-label-field">启用底盘调试模式 (Advanced Mode)</text>
            <switch color="#1e40af" checked="{{advancedMode}}" bindchange="onAdvancedModeChange" />
          </view>
          <view class="tips-row">端点: {{wsUrl || '尚未生成'}} ｜ socket: {{lastSocketText}}</view>
        </view>
      </view>

      <!-- 串口物理连接 -->
      <view class="card" wx:if="{{advancedMode}}">
        <view class="section-header">
          <view>
            <view class="section-title">网关物理串口调试</view>
            <view class="section-subtitle">管理边缘网关物理串口连线与波特率</view>
          </view>
          <button class="ghost-btn" size="mini" bindtap="requestPorts">枚举端口</button>
        </view>
        <view class="form-grid">
          <view class="form-row">
            <text class="form-label">物理串口号 (Device Port)</text>
            <picker mode="selector" range="{{portLabels}}" value="{{portIndex}}" bindchange="onPortPickerChange">
              <view class="picker-field">{{portLabels[portIndex] || '未发现有效物理端口'}}</view>
            </picker>
          </view>
          <view class="form-row">
            <text class="form-label">波特率 (Baud Rate)</text>
            <input class="field-input compact-input" value="{{baudRateInput}}" bindinput="setFormField" data-key="baudRateInput" type="number" />
          </view>
        </view>
        <view class="action-grid action-grid-two">
          <button class="primary-btn" size="mini" bindtap="openSerial">打开物理串口</button>
          <button class="ghost-btn" size="mini" bindtap="closeSerial">断开物理串口</button>
        </view>
        <view class="textarea-block">
          <textarea class="field-textarea" value="{{sendInput}}" bindinput="setFormField" data-key="sendInput" placeholder='十六进制原始报文或 JSON {"t":"cmd","cmd":"stop"}'></textarea>
        </view>
        <view class="switch-grid">
          <view class="switch-row">
            <text class="switch-label-field">自动追加 \r\n</text>
            <switch color="#1e40af" checked="{{appendNewline}}" bindchange="onAppendNewlineChange" />
          </view>
          <view class="switch-row">
            <text class="switch-label-field">追加前导 FF FF</text>
            <switch color="#1e40af" checked="{{broadcastMode}}" bindchange="onBroadcastModeChange" />
          </view>
        </view>
        <button class="primary-btn full-btn" size="mini" bindtap="sendRawSerial">发送原始报文</button>
      </view>

      <!-- 水域网格管理 -->
      <view class="card" wx:if="{{advancedMode}}">
        <view class="section-header">
          <view>
            <view class="section-title">水域网格管理</view>
            <view class="section-subtitle">配置或删除养殖水域边界及预设阈值</view>
          </view>
        </view>
        <view class="action-grid action-grid-three">
          <button class="primary-btn" size="mini" bindtap="openCreateZoneEditor">新增网格</button>
          <button class="outline-btn" size="mini" bindtap="openEditZoneEditor">编辑当前</button>
          <button class="danger-btn" size="mini" bindtap="deleteZone">删除当前</button>
        </view>
        <view class="form-row compact-top">
          <text class="form-label">恢复归档水域</text>
          <picker mode="selector" range="{{deletedZoneLabels}}" value="{{deletedZoneIndex}}" bindchange="onDeletedZoneChange">
            <view class="picker-field">{{deletedZoneLabels[deletedZoneIndex] || '无历史归档网格'}}</view>
          </picker>
        </view>
        <button class="ghost-btn full-btn compact-top" size="mini" bindtap="recoverZone">恢复已归档水域</button>

        <!-- 区域编辑器面板 (抽屉样式) -->
        <view wx:if="{{zoneEditorVisible}}" class="editor-panel">
          <view class="editor-title">{{zoneEditorMode === 'edit' ? '编辑养殖水域' : '新增养殖水域'}}</view>
          <view class="form-grid">
            <view class="form-row">
              <text class="form-label">水域名称</text>
              <input class="field-input compact-input" value="{{zoneForm.name}}" bindinput="setFormField" data-key="zoneForm.name" placeholder="例如：B区 罗非鱼塘" />
            </view>
            <view class="form-row">
              <text class="form-label">饲养方式</text>
              <picker mode="selector" range="{{speciesModeLabels}}" value="{{speciesModeIndex}}" bindchange="onSpeciesModeChange">
                <view class="picker-field">{{speciesModeLabels[speciesModeIndex] || '内置常规鱼类'}}</view>
              </picker>
            </view>
            <view class="form-row" wx:if="{{zoneForm.speciesMode === 'builtin'}}">
              <text class="form-label">预设品种常规参数</text>
              <picker mode="selector" range="{{builtinSpeciesLabels}}" value="{{builtinSpeciesIndex}}" bindchange="onBuiltinSpeciesChange">
                <view class="picker-field">{{builtinSpeciesLabels[builtinSpeciesIndex] || '点击选择常见水产品'}}</view>
              </picker>
            </view>
            <view class="form-row" wx:if="{{zoneForm.speciesMode === 'custom'}}">
              <text class="form-label">自定义特种养殖物种名</text>
              <input class="field-input compact-input" value="{{zoneForm.customSpeciesName}}" bindinput="setFormField" data-key="zoneForm.customSpeciesName" placeholder="特种物种名称" />
            </view>
          </view>
          
          <view class="triple-grid compact-top">
            <input class="field-input compact-input" value="{{zoneForm.phMin}}" bindinput="setFormField" data-key="zoneForm.phMin" placeholder="pH 下限" />
            <input class="field-input compact-input" value="{{zoneForm.phMax}}" bindinput="setFormField" data-key="zoneForm.phMax" placeholder="pH 上限" />
            <input class="field-input compact-input" value="{{zoneForm.turbidityMax}}" bindinput="setFormField" data-key="zoneForm.turbidityMax" placeholder="最大浊度" />
          </view>
          <view class="triple-grid compact-top">
            <input class="field-input compact-input" value="{{zoneForm.tempMin}}" bindinput="setFormField" data-key="zoneForm.tempMin" placeholder="最低温度" />
            <input class="field-input compact-input" value="{{zoneForm.tempMax}}" bindinput="setFormField" data-key="zoneForm.tempMax" placeholder="最高温度" />
            <input class="field-input compact-input" value="{{zoneForm.lengthM}}" bindinput="setFormField" data-key="zoneForm.lengthM" placeholder="南北轴(m)" />
          </view>
          <view class="double-grid compact-top" wx:if="{{!hideLocation}}">
            <input class="field-input compact-input" value="{{zoneForm.latitude}}" bindinput="setFormField" data-key="zoneForm.latitude" placeholder="中心轴纬度" />
            <input class="field-input compact-input" value="{{zoneForm.longitude}}" bindinput="setFormField" data-key="zoneForm.longitude" placeholder="中心轴经度" />
          </view>
          <view class="form-row compact-top" wx:if="{{hideLocation}}">
            <text class="form-label">区域中心</text>
            <text class="form-value-hidden">已隐藏（比赛要求）</text>
          </view>
          <view class="double-grid compact-top">
            <input class="field-input compact-input" value="{{zoneForm.widthM}}" bindinput="setFormField" data-key="zoneForm.widthM" placeholder="东西轴宽度(m)" />
          </view>
          <view class="action-grid action-grid-two compact-top">
            <button class="primary-btn" size="mini" bindtap="saveZone">应用网格</button>
            <button class="ghost-btn" size="mini" bindtap="closeZoneEditor">放弃</button>
          </view>
        </view>
      </view>

      <!-- 巡检参数与硬件诊断 -->
      <view class="card" wx:if="{{advancedMode}}">
        <view class="section-header">
          <view>
            <view class="section-title">精密传感器与巡航参数设定</view>
            <view class="section-subtitle">配置自动靠岸半径、采样滞留延迟</view>
          </view>
        </view>
        <view class="triple-grid">
          <input class="field-input compact-input" value="{{samplingForm.arrivalRadiusM}}" bindinput="setFormField" data-key="samplingForm.arrivalRadiusM" placeholder="靠岸半径 M" />
          <input class="field-input compact-input" value="{{samplingForm.fallbackRadiusM}}" bindinput="setFormField" data-key="samplingForm.fallbackRadiusM" placeholder="脱困半径 M" />
          <input class="field-input compact-input" value="{{samplingForm.fallbackAfterMs}}" bindinput="setFormField" data-key="samplingForm.fallbackAfterMs" placeholder="脱困延迟 MS" />
        </view>
        <view class="triple-grid compact-top">
          <input class="field-input compact-input" value="{{samplingForm.targetTimeoutMs}}" bindinput="setFormField" data-key="samplingForm.targetTimeoutMs" placeholder="超时限时 MS" />
          <input class="field-input compact-input" value="{{samplingForm.stabilizationMs}}" bindinput="setFormField" data-key="samplingForm.stabilizationMs" placeholder="稳定延时 MS" />
          <input class="field-input compact-input" value="{{samplingForm.sampleIntervalMs}}" bindinput="setFormField" data-key="samplingForm.sampleIntervalMs" placeholder="采样间隔 MS" />
        </view>
        <view class="double-grid compact-top">
          <input class="field-input compact-input" value="{{samplingForm.sampleDurationMs}}" bindinput="setFormField" data-key="samplingForm.sampleDurationMs" placeholder="采样总时长 MS" />
        </view>
        <view class="action-grid action-grid-two compact-top">
          <button class="primary-btn" size="mini" bindtap="saveSamplingConfig">持久化采样参数</button>
          <button class="danger-btn" size="mini" bindtap="clearSelectedZoneSamples">重置并清空样本</button>
        </view>
        
        <!-- 仿真调试测试写入 -->
        <view class="triple-grid compact-top">
          <input class="field-input compact-input" value="{{testSampleForm.ph}}" bindinput="setFormField" data-key="testSampleForm.ph" placeholder="模拟 pH" />
          <input class="field-input compact-input" value="{{testSampleForm.tempC}}" bindinput="setFormField" data-key="testSampleForm.tempC" placeholder="模拟温度" />
          <input class="field-input compact-input" value="{{testSampleForm.turbidity}}" bindinput="setFormField" data-key="testSampleForm.turbidity" placeholder="模拟浊度" />
        </view>
        <button class="ghost-btn full-btn compact-top" size="mini" bindtap="sendTestSample">注入虚拟仿真样本</button>
      </view>

      <!-- 历史样本删改 (高级操作) -->
      <view class="card" wx:if="{{advancedMode}}">
        <view class="section-header">
          <view>
            <view class="section-title">大容量历史样本批处理</view>
            <view class="section-subtitle">物理级批量删除、多选及过滤</view>
          </view>
        </view>
        <view class="form-row">
          <text class="form-label">选定特定水域筛选</text>
          <picker mode="selector" range="{{sampleFilterLabels}}" value="{{sampleFilterIndex}}" bindchange="onSampleFilterChange">
            <view class="picker-field">{{sampleFilterLabels[sampleFilterIndex] || '全部历史水域样本'}}</view>
          </picker>
        </view>
        <checkbox-group bindchange="onSampleSelectionChange">
          <view wx:if="{{sampleHistoryItems.length}}" class="history-list compact-top">
            <block wx:for="{{sampleHistoryItems}}" wx:key="id">
              <label class="history-item history-select-item">
                <checkbox value="{{item.id}}" checked="{{item.checked}}" color="#1e40af" />
                <view class="history-content">
                  <view class="history-item-title">{{item.title}}</view>
                  <view class="history-item-value">{{item.subtitle}}</view>
                </view>
              </label>
            </block>
          </view>
        </checkbox-group>
        <view wx:if="{{!sampleHistoryItems.length}}" class="empty-block">该检索条件下无任何历史样本记录</view>
        <button class="danger-btn full-btn compact-top" size="mini" bindtap="deleteSelectedSamples">彻底删除勾选样本</button>
      </view>

      <!-- LLM 配置中心 -->
      <view class="card" wx:if="{{advancedMode}}">
        <view class="section-header">
          <view>
            <view class="section-title">云端 LLM 参数设置</view>
            <view class="section-subtitle">配置大模型 API 与第三方模型网关</view>
          </view>
        </view>
        <view class="form-row">
          <text class="form-label">供应商端 (AI Engine Provider)</text>
          <picker mode="selector" range="{{llmProviderLabels}}" value="{{llmProviderIndex}}" bindchange="onLlmProviderChange">
            <view class="picker-field">{{llmProviderLabels[llmProviderIndex] || '本地轻量算法兜底'}}</view>
          </picker>
        </view>
        <view class="form-grid compact-top">
          <view class="form-row">
            <text class="form-label">API Base URL Endpoint</text>
            <input class="field-input compact-input" value="{{llmForm.cloudEndpoint}}" bindinput="setFormField" data-key="llmForm.cloudEndpoint" placeholder="https://api..." />
          </view>
          <view class="form-row">
            <text class="form-label">API Bearer Bearer Secret Key</text>
            <input class="field-input compact-input" password="true" value="{{llmForm.cloudApiKey}}" bindinput="setFormField" data-key="llmForm.cloudApiKey" placeholder="sk-..." />
          </view>
          <view class="form-row">
            <text class="form-label">模型标识名 (Model Name)</text>
            <input class="field-input compact-input" value="{{llmForm.cloudModel}}" bindinput="setFormField" data-key="llmForm.cloudModel" placeholder="deepseek-reasoner" />
          </view>
          <view class="form-row">
            <text class="form-label">局域网 Ollama 节点端口</text>
            <input class="field-input compact-input" value="{{llmForm.ollamaEndpoint}}" bindinput="setFormField" data-key="llmForm.ollamaEndpoint" placeholder="http://192.168.1.100:11434/api/chat" />
          </view>
          <view class="form-row">
            <text class="form-label">Ollama 物理模型标称</text>
            <input class="field-input compact-input" value="{{llmForm.ollamaModel}}" bindinput="setFormField" data-key="llmForm.ollamaModel" placeholder="llama3:8b" />
          </view>
        </view>
        <view class="tip-block">注意：若使用 Anthropic 兼容模式，网关将自动载入并对齐网关环境变量，无需反复录入私钥。配置状态：{{llmForm.anthropicConfigured ? '已生效' : '未就绪'}}</view>
        <button class="primary-btn full-btn compact-top" size="mini" bindtap="saveLlmConfig">部署 LLM 配置表</button>
      </view>

      <!-- 原始控制台总览与串口监测 -->
      <view class="card">
        <view class="section-header">
          <view>
            <view class="section-title">物联网遥测与透传串口日志</view>
            <view class="section-subtitle">设备发送的原生遥测与串口原始状态</view>
          </view>
        </view>
        <view class="code-title">实时接收到的底层 JSON 报文</view>
        <scroll-view class="code-scroll" scroll-x="true">
          <text wx:if="{{!hideLocation}}" class="code-block">{{rawJsonText}}</text>
          <text wx:if="{{hideLocation}}" class="code-block code-hidden">底层报文已隐藏位置信息（比赛要求）</text>
        </scroll-view>
        
        <view class="code-title compact-top">物理串口透传调试原始数据</view>
        <scroll-view class="code-scroll log-scroll" scroll-y="true">
          <text class="code-block">{{rawLogText}}</text>
        </scroll-view>
        
        <view class="code-title compact-top">指令历史流与解析时间戳</view>
        <view wx:if="{{hideLocation}}" class="empty-block">历史流已隐藏位置信息（比赛要求）</view>
        <view wx:elif="{{historyItems.length}}" class="history-list">
          <block wx:for="{{historyItems}}" wx:key="id">
            <view class="history-item column-item">
              <view class="history-item-title">节点: {{item.type}} ｜ {{item.timestamp}}</view>
              <view class="history-item-value">{{item.raw}}</view>
            </view>
          </block>
        </view>
        <view wx:else class="empty-block">暂无解析历史</view>
      </view>

    </block>

  </view>
</scroll-view>
