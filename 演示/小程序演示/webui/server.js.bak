// 演示用网关服务器：为小程序提供 WebSocket 命令协议后端
// 伪造 GPS、浊度、边缘 AI 数据；AI 对话直接返回固定回复
// 运行：node server.js  （默认端口 8765，匹配小程序默认配置）
const http = require('http');
const fs = require('fs');
const path = require('path');
const { WebSocketServer } = require('ws');

const PORT = process.env.PORT ? Number(process.env.PORT) : 8765;

// --- 内置养殖对象（与 webui 一致）---
const BUILTIN_SPECIES = {
  grass_carp: { label: '草鱼', thresholds: { phMin: 6.5, phMax: 8.5, tempMin: 18, tempMax: 30, turbidityMax: 30 } },
  crucian_carp: { label: '鲫鱼', thresholds: { phMin: 6.5, phMax: 8.5, tempMin: 16, tempMax: 30, turbidityMax: 35 } },
  carp: { label: '鲤鱼', thresholds: { phMin: 6.5, phMax: 8.5, tempMin: 18, tempMax: 30, turbidityMax: 35 } },
  bass: { label: '鲈鱼', thresholds: { phMin: 7.0, phMax: 8.5, tempMin: 20, tempMax: 30, turbidityMax: 25 } },
  shrimp: { label: '虾', thresholds: { phMin: 7.5, phMax: 8.8, tempMin: 20, tempMax: 32, turbidityMax: 30 } },
  crab: { label: '蟹', thresholds: { phMin: 7.5, phMax: 8.8, tempMin: 20, tempMax: 30, turbidityMax: 30 } },
};

// --- 5 个演示区域（与 webui seed 一致）---
function seedZones() {
  const now = new Date().toISOString();
  const seeds = [
    ['zone_A', 'A区 草鱼塘', 'grass_carp', 34.5001, 104.0001],
    ['zone_B', 'B区 鲫鱼塘', 'crucian_carp', 34.5003, 104.0003],
    ['zone_C', 'C区 鲤鱼塘', 'carp', 34.5005, 104.0005],
    ['zone_D', 'D区 鲈鱼塘', 'bass', 34.5007, 104.0007],
    ['zone_E', 'E区 虾塘', 'shrimp', 34.5009, 104.0009],
  ];
  return seeds.map(([id, name, key, lat, lon]) => {
    const s = BUILTIN_SPECIES[key];
    return {
      id, name,
      speciesProfile: { type: 'builtin', key, label: s.label, thresholds: { ...s.thresholds } },
      geometry: { type: 'axis_aligned_rectangle', center: { latitude: lat, longitude: lon }, lengthM: 20, widthM: 10 },
      deletedAt: null, createdAt: now, updatedAt: now,
    };
  });
}

const ZONES = seedZones();

const DEFAULT_SAMPLING_CONFIG = {
  arrivalRadiusM: 1, fallbackRadiusM: 5, fallbackAfterMs: 60000,
  targetTimeoutMs: 600000, stabilizationMs: 30000, sampleIntervalMs: 5000, sampleDurationMs: 3600000,
};

// --- 伪造遥测数据（GPS/浊度/边缘AI 均为正常值）---
function makeFakeData(seq) {
  return {
    t: 'data',
    seq: seq,
    ms: Date.now() % 1000000,
    // pH（模拟正常 7.20）
    ph: 720, phr: 720, phmv: 0,
    // 水温（模拟正常 24.00℃）
    tc: 2400, tv: 1,
    // 浊度（模拟正常 15 NTU；真实传感器已坏）
    tb: 15, tbr: 1500, tbmv: 1500, td: 0, tbv: 1,
    // GPS（模拟正常定位；真实传感器已坏）
    fix: 1, sat: 8, lat: 345001000, lon: 1040001000, gb: 80, gl: 5,
    // IMU（模拟有效）
    iv: 1, ir: 0, ip: 0, iy: 4500, ib: 0, ia: 0,
    // 边缘 AI（强制判定可信）
    aiphn: 1, aitn: 1,
    // 导航
    ns: 0, nd: 0, nh: 0,
    // 电机校准
    mls: 100, mrs: 100, mlo: 0, mro: 0,
  };
}

function makeFakeBoot() {
  return {
    t: 'boot', msg: 'boat telemetry start (demo)', ver: 'demo-v1',
    div: 100, phdiv: 100, tbdiv: 100, mls: 100, mrs: 100, mlo: 0, mro: 0,
  };
}

const FAKE_PORTS = [
  { path: 'COM3', manufacturer: '演示串口', friendlyName: 'Demo Serial Port', serialNumber: '', vendorId: '', productId: '' },
];

function nowIso() { return new Date().toISOString(); }

function makeStatus(connected) {
  return {
    connected: connected,
    portPath: connected ? 'COM3' : null,
    baudRate: 115200,
    partialBytes: 0,
    lastMessageAt: nowIso(),
  };
}

function makeSnapshot() {
  return {
    type: 'snapshot',
    payload: {
      status: makeStatus(false),
      latestBoot: makeFakeBoot(),
      latestData: makeFakeData(1),
      zones: ZONES,
      samples: [],
      latestSampleByZone: {},
      sampling: { status: 'idle', task: null, warning: null, config: { ...DEFAULT_SAMPLING_CONFIG } },
      builtinSpecies: BUILTIN_SPECIES,
      riskAnalyses: {},
      selectedTarget: null,
      ports: FAKE_PORTS,
      history: [],
      logs: [],
      llmConfig: { provider: 'disabled', enabled: false, cloudEndpoint: '', cloudApiKey: '', cloudModel: '', ollamaEndpoint: '', ollamaModel: '', anthropicConfigured: false, anthropicModel: '' },
    },
  };
}

// --- AI 对话固定回复 ---
function buildCannedReply(zone, message) {
  const speciesLabel = zone?.speciesProfile?.label || '养殖对象';
  const safeQuestion = String(message || '').trim().slice(0, 500) || '请分析该区域当前水质并给出养殖建议';
  return `【AI 分析建议】${zone.name}（${speciesLabel}）当前水质状况良好。\n\n` +
    `最新数据：pH 7.20，水温 24.0℃，浊度 15 NTU，GPS 已定位，边缘 AI 校验均为可信。\n\n` +
    `针对"${safeQuestion}"：\n` +
    `1) 当前判断：各项指标处于适宜范围，水质正常。\n` +
    `2) 投喂/换水：可按正常节奏投喂，暂不需要紧急换水。\n` +
    `3) 下一步操作：建议继续保持定期巡检，关注 pH 与浊度趋势变化。\n` +
    `4) 边缘 AI 校验：pH 与水温数据均判定为可信，传感器状态正常。`;
}

function getZoneById(zoneId) {
  return ZONES.find((z) => z.id === zoneId && !z.deletedAt) || null;
}

// --- 命令处理 ---
function handleCommand(socket, action, payload, ctx) {
  const send = (msg) => { if (socket.readyState === socket.OPEN) socket.send(JSON.stringify(msg)); };

  switch (action) {
    case 'get_ports':
      send({ type: 'ports', payload: { ports: FAKE_PORTS } });
      break;

    case 'serial_open': {
      ctx.connected = true;
      send({ type: 'ack', payload: { message: `已连接演示串口 ${payload?.path || 'COM3'}@${payload?.baudRate || 115200}` } });
      send({ type: 'serial_status', payload: { status: makeStatus(true) } });
      break;
    }

    case 'serial_close': {
      ctx.connected = false;
      send({ type: 'ack', payload: { message: '串口已断开' } });
      send({ type: 'serial_status', payload: { status: makeStatus(false) } });
      break;
    }

    case 'serial_send':
      send({ type: 'ack', payload: { message: '演示模式：指令已发送' } });
      break;

    case 'chat': {
      const zone = getZoneById(payload?.zoneId);
      if (!zone) { send({ type: 'error', payload: { message: '区域不存在' } }); break; }
      send({
        type: 'chat_result',
        payload: {
          zoneId: zone.id,
          reply: buildCannedReply(zone, payload?.message),
          source: 'llm',
          analyzedAt: nowIso(),
        },
      });
      break;
    }

    case 'analyze_zone': {
      const zone = getZoneById(payload?.zoneId);
      if (!zone) { send({ type: 'error', payload: { message: '区域不存在' } }); break; }
      send({
        type: 'analysis_result',
        payload: {
          zoneId: zone.id,
          analysis: {
            level: 'normal', summary: '当前水质处于适宜范围', reasons: [], suggestions: [],
            confidence: 'medium', source: 'rule', analyzedAt: nowIso(),
          },
        },
      });
      break;
    }

    case 'analyze_all': {
      const analyses = {};
      for (const z of ZONES) {
        analyses[z.id] = {
          level: 'normal', summary: '当前水质处于适宜范围', reasons: [], suggestions: [],
          confidence: 'medium', source: 'rule', analyzedAt: nowIso(),
        };
      }
      send({ type: 'batch_analysis_result', payload: { analyses } });
      break;
    }

    case 'manual_sample':
    case 'test_sample': {
      const zone = getZoneById(payload?.zoneId);
      if (!zone) { send({ type: 'error', payload: { message: '区域不存在' } }); break; }
      const sample = {
        id: `sample_${Date.now()}`,
        zoneId: zone.id,
        receivedAt: nowIso(), savedAt: nowIso(),
        source: action === 'test_sample' ? 'advanced_test' : 'manual',
        attributionMethod: action === 'test_sample' ? 'advanced_test' : 'manual_override',
        gpsValidation: { validated: false, arrivalMode: 'manual_override', distanceToTargetM: null },
        water: {
          ph: 7.20, tempC: 24.0, turbidity: 15,
          phRaw: null, phMv: null, turbidityRaw: null, turbidityMv: null,
          turbidityDigital: null, temperatureValid: true,
        },
        edgeAi: { phNormal: true, temperatureNormal: true },
        gps: { fix: 1, satellites: 8, latitude: 34.5001, longitude: 104.0001, rawLat: 345001000, rawLon: 1040001000 },
        imu: { valid: true, roll: 0, pitch: 0, yaw: 45.0, raw: {} },
        raw: { t: 'demo_sample' },
        deletedAt: null,
      };
      send({
        type: 'sample_created',
        payload: {
          sample,
          latestSampleByZone: { [zone.id]: sample },
          sampling: { status: 'idle', task: null, warning: null, config: { ...DEFAULT_SAMPLING_CONFIG } },
        },
      });
      break;
    }

    case 'start_zone_sampling':
    case 'cancel_sampling':
    case 'send_target':
    case 'clear_target':
    case 'quick_cmd':
    case 'motor_command':
    case 'calibration':
    case 'update_zone':
    case 'create_zone':
    case 'delete_zone':
    case 'recover_zone':
    case 'update_sampling_config':
    case 'delete_samples':
    case 'clear_zone_samples':
    case 'update_llm_config':
      send({ type: 'ack', payload: { message: '演示模式：指令已接收' } });
      break;

    default:
      send({ type: 'ack', payload: { message: `已接收指令: ${action}` } });
  }
}

// --- WebSocket 服务器（根路径，匹配小程序 ws://ip:port）---
const server = http.createServer();
const wss = new WebSocketServer({ server });

wss.on('connection', (socket) => {
  const ctx = { connected: false };
  console.log('小程序已连接');

  // 发送初始快照
  socket.send(JSON.stringify(makeSnapshot()));

  // 周期性遥测（每 2 秒推送一次伪造数据）
  let seq = 2;
  const telemetryTimer = setInterval(() => {
    if (socket.readyState !== socket.OPEN) return;
    const telemetry = {
      type: 'telemetry',
      payload: {
        status: makeStatus(true),
        latestBoot: makeFakeBoot(),
        latestData: makeFakeData(seq++),
        selectedTarget: null,
      },
    };
    socket.send(JSON.stringify(telemetry));
  }, 2000);

  socket.on('message', (raw) => {
    let message;
    try {
      message = JSON.parse(raw.toString());
    } catch (e) {
      return;
    }

    if (message.type === 'hello') {
      // 已发送快照，无需额外处理
      return;
    }

    if (message.type === 'command') {
      handleCommand(socket, message.action, message.payload || {}, ctx);
      return;
    }
  });

  socket.on('close', () => {
    clearInterval(telemetryTimer);
    console.log('小程序已断开');
  });

  socket.on('error', (err) => {
    console.warn('连接错误:', err.message);
  });
});

server.listen(PORT, () => {
  console.log(`演示网关服务器已启动：ws://localhost:${PORT}`);
  console.log('小程序连接地址：ws://127.0.0.1:' + PORT);
  console.log('（在微信开发者工具中关闭"校验合法域名"即可连接 localhost）');
});
