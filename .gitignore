# ============================================================
# BOAT / 智航清泓 — Git 忽略规则
# 原则：只追踪源码、工程配置、文档
# ============================================================

# ---------- 编译产物（保留 Debug/ 下的 makefile 等工程文件）----------
Debug/*.elf
Debug/*.elf.bak
Debug/*.map
Debug/*.list
# objects.list 是链接输入（CubeIDE 生成的 OBJS 清单），必须入库，否则 clone 下来 make 直接报 No rule to make target
!/Debug/objects.list
Debug/*.bin
Debug/**/*.o
Debug/**/*.d
Debug/**/*.su
Debug/**/*.cyclo

# ---------- 依赖 ----------
node_modules/

# ---------- 大体积媒体与文档导出 ----------
*.mp4
*.rar
*.zip
*.pdf
*.docx
*.pptx
*.jpg
*.jpeg
*.png
*.bmp

# 例外：NanoEdge AI 模型包是构建依赖，必须保留
!AI/**/*.zip

# ---------- LaTeX 中间产物 ----------
*.aux
*.log
*.toc
*.out
*.fls
*.fdb_latexmk

# ---------- boatctl 录制与临时产物 ----------
# runs/ 是每次实跑的数据归档，体积会持续增长，不入库
tools/boatctl/tmp/
tools/boatctl/runs/
*.jsonl
record-*.jsonl
# 示例数据仅作格式参考，保留入库
!tools/boatctl/examples/*.jsonl

# ---------- 归档与参考资料（不属于本项目代码）----------
# 注意用 /archive/ 锚定根目录，否则会连 docs/archive/ 一起忽略
/archive/
资料/

# ---------- 船体 CAD 工作目录 ----------
# 正在实时编辑的建模脚本与中间产物（.npy/.STL），暂不纳入版本控制。
# 若要纳入，删掉这条规则并单独提交一次。
/模型/

# ---------- Python 产物 ----------
__pycache__/
*.pyc
*.npy

# ---------- 户外便携离线包（1.5 GB，不入库）----------
/_outdoor_kit/

# ---------- 系统 ----------
Thumbs.db
desktop.ini
.DS_Store
*.tmp
_kits/
_relaykit/
outdoor-kit.zip
relay-kit.zip
