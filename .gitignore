# ============================================================
# BOAT / 智航清泓 — Git 忽略规则
# 原则：只追踪源码、工程配置、文档
# ============================================================

# ---------- 编译产物（保留 Debug/ 下的 makefile 等工程文件）----------
Debug/*.elf
Debug/*.elf.bak
Debug/*.map
Debug/*.list
Debug/*.bin
Debug/**/*.o
Debug/**/*.d
Debug/**/*.su
Debug/**/*.cyclo

# ---------- 依赖 ----------
node_modules/

# ---------- 大体积媒体与文档导出 ----------
*.mp4
*.rar
*.zip
*.pdf
*.docx
*.pptx
*.jpg
*.jpeg
*.png
*.bmp

# 例外：NanoEdge AI 模型包是构建依赖，必须保留
!AI/**/*.zip

# ---------- LaTeX 中间产物 ----------
*.aux
*.log
*.toc
*.out
*.fls
*.fdb_latexmk

# ---------- 归档与参考资料（不属于本项目代码）----------
# 注意用 /archive/ 锚定根目录，否则会连 docs/archive/ 一起忽略
/archive/
资料/

# ---------- 系统 ----------
Thumbs.db
desktop.ini
.DS_Store
*.tmp
